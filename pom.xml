<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.schachlernapp</groupId>
    <artifactId>schachlernapp</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Schach-Lernapp</name>
    <description>PC-App zum Schach lernen (Puzzle-Trainer als Alternative zu chess.com)</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.4</javafx.version>
        <chesslib.version>1.3.7</chesslib.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <gson.version>2.14.0</gson.version>

        <!-- Haupteinstiegspunkt für javafx-maven-plugin und Shade/Manifest.
             Zeigt auf Launcher statt direkt auf Main (das Application erweitert) -
             siehe Launcher-Javadoc für den Grund (java -jar bricht sonst ab). -->
        <mainClass>org.schachlernapp.Launcher</mainClass>
    </properties>

    <repositories>
        <!-- chesslib wird nicht auf Maven Central veröffentlicht, sondern über JitPack bezogen -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.bhlangonijr</groupId>
            <artifactId>chesslib</artifactId>
            <version>${chesslib.version}</version>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                Packaging (M7): baut ein ausführbares Fat-Jar (java -jar target/schachlernapp-<version>.jar).
                javafx-maven-plugin oben bleibt für den Dev-Workflow (./mvnw javafx:run) unverändert.

                Hinweis: Das Jar enthält nur die nativen JavaFX-Bibliotheken der Build-Plattform
                (siehe mvn dependency:tree - javafx-* zieht automatisch den passenden Plattform-
                Klassifikator, hier "linux", transitiv mit). Für Windows/Mac müsste separat auf der
                jeweiligen Plattform gebaut werden - nicht Teil von M7.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                                <!-- Ohne diesen Transformer würde eine Jar-Datei die META-INF/services-Einträge
                                     der anderen überschreiben statt zusammenzuführen - sqlite-jdbc registriert
                                     seinen JDBC-Treiber genau darüber (java.sql.Driver). -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Mehrere Jars mit eigenem Modul-Deskriptor können nicht zu einem
                                             gemeinsamen module-info.class zusammengeführt werden - wird beim
                                             Start als Classpath-Jar (java -jar) ohnehin nicht benötigt. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
